<Window x:Class="BookingService.MVVM.Views.EditRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BookingService - Редактирование номера" 
        Height="760" 
        Width="850"
        MinWidth="700"
        MinHeight="600"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="D:\5sem\course-work\course-work-app\BookingService\Resources\icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="360" 
                     Style="{DynamicResource {x:Type TextBox}}" Margin="0,0,10,0"/>
            <Popup x:Name="SearchPopup" 
               PlacementTarget="{Binding ElementName=SearchTextBox}" 
               StaysOpen="False" 
               IsOpen="{Binding IsSearchPopupOpen}"
               Width="{Binding ActualWidth, ElementName=SearchTextBox}">
                <ListBox ItemsSource="{Binding SearchResults}" 
                     SelectedItem="{Binding SelectedRoom}"
                     MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ShortDescription}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Popup>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Краткое описание:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ShortDescription, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Полное описание:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FullDescription, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{DynamicResource {x:Type TextBox}}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:" Style="{DynamicResource FormLabelText}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Style="{DynamicResource {x:Type ComboBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Рейтинг:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Rating, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Цена:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Количество кроватей:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding NumberOfBeds, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Звёзды:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Stars, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Удобства:" Style="{DynamicResource FormLabelText}"/>
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Amenities, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Балкон:" Style="{DynamicResource FormLabelText}"/>
                <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding HasBalcony}" Style="{DynamicResource {x:Type CheckBox}}" VerticalAlignment="Center" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Не для курящих:" Style="{DynamicResource FormLabelText}"/>
                <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding IsNonSmoking}" Style="{DynamicResource {x:Type CheckBox}}" VerticalAlignment="Center" Margin="0,2,0,12"/>

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Изображение:" Style="{DynamicResource FormLabelText}"/>
                <Grid Grid.Row="11" Grid.Column="1" Margin="0,2,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{DynamicResource {x:Type TextBox}}"/>
                    <Button Grid.Row="0" Grid.Column="1" Content="Обзор" 
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding BrowseImageCommand}" Margin="8,0,0,0" VerticalAlignment="Center"/>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                            BorderBrush="Gray" BorderThickness="1" Margin="0,10,0,0"
                            HorizontalAlignment="Left">
                        <Image Source="{Binding ImagePreview}" Width="200" Height="150" Stretch="Uniform"/>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" 
                    Style="{DynamicResource PrimaryButton}" 
                    Command="{Binding SaveCommand}" 
                    FontSize="16"
                    Visibility="{Binding IsFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0"/>
            <Button Content="Отмена" 
                    Style="{DynamicResource SecondaryButton}" 
                    Command="{Binding CancelCommand}" 
                    FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>