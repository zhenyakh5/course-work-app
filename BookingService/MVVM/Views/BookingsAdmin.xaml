<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BookingService.MVVM.Views.BookingsAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BookingService - Управление бронированиями"
        Height="450"
        Width="700"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="D:\5sem\course-work\course-work-app\BookingService\Resources\icon.ico">
    <Grid Margin="12">
        <StackPanel>
            <Label Content="Бронирования"/>
            <DataGrid ItemsSource="{Binding Bookings}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding User.Username}" Width="*"/>
                    <DataGridTextColumn Header="Комната" Binding="{Binding Room.Name}" Width="*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding TotalPrice, StringFormat={}{0:C}}" Width="100"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                    <DataGridTemplateColumn Header="Действия" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Подтвердить" Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                    <Button Content="Отменить" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="4"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>