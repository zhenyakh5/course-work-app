<Window x:Class="BookingService.MVVM.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingService"
        mc:Ignorable="d"
        Title="BookingService - Авторизация" 
        Height="500" 
        Width="400"
        Background="{DynamicResource BackgroundBrush}"
        Cursor="{StaticResource NormalCursor}"
        WindowStartupLocation="CenterScreen"
        Icon="D:\5sem\course-work\course-work-app\BookingService\Resources\icon.ico">

    <Grid>
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Orientation="Vertical" 
                    Margin="20">

            <Label Content="Добро пожаловать" 
                   Style="{DynamicResource HeaderLabel}"/>

            <Label Content="Имя пользователя" Style="{DynamicResource FormLabel}"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

            <Label Content="Пароль" Style="{DynamicResource FormLabel}"/>
            <PasswordBox x:Name="PasswordBox" 
                         Style="{DynamicResource {x:Type PasswordBox}}" Margin="0,2,0,12"/>

            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">

                <Button Content="Войти" 
                        Style="{DynamicResource PrimaryButton}" 
                        Command="{Binding LoginCommand}" Margin="0,0,12,0"/>

                <Button Content="Регистрация" 
                        Style="{DynamicResource SecondaryButton}" 
                        Command="{Binding RegisterCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>