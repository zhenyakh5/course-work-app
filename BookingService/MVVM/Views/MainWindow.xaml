<Window x:Class="BookingService.MVVM.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingService"
        mc:Ignorable="d"
        Title="BookingService - Главная"
        Width="1440"
        Height="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="D:\5sem\course-work\course-work-app\BookingService\Resources\icon.ico">

    <Window.DataContext>
        <vm:MainWindowViewModel xmlns:vm="clr-namespace:BookingService.MVVM.ViewModels" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12">
                <Button Content="Профиль" 
                        Style="{DynamicResource SecondaryButton}"
                        FontSize="14" Margin="0,0,10,0"
                        Command="{Binding ProfileCommand}"/>

                <Button x:Name="AdminPanelButton" Content="Панель админа"
                        Style="{DynamicResource SecondaryButton}"
                        FontSize="14"
                        Command="{Binding AdminPanelCommand}" Margin="0,0,10,0"/>

                <Button Content="Обновить" 
                        Style="{DynamicResource SecondaryButton}"
                        FontSize="14" Margin="0,0,10,0"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <TextBox FontSize="16" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="36" Height="36" 
                         Style="{DynamicResource {x:Type TextBox}}" MinWidth="260"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="12">
                <StackPanel Orientation="Horizontal">
                    <Button Content="A-Z" 
                            Style="{DynamicResource SecondaryButton}"
                            FontSize="14" Margin="0,0,6,0"
                            Command="{Binding AlphabetSortCommand}"/>
                    <Button Content="Цена ↑" 
                            Style="{DynamicResource SecondaryButton}"
                            FontSize="14" Margin="0,0,6,0"
                            Command="{Binding CostAscSortCommand}"/>
                    <Button Content="Цена ↓" 
                            Style="{DynamicResource SecondaryButton}"
                            FontSize="14"
                            Command="{Binding CostDescSortCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BackgroundBrush}">
                <ItemsControl ItemsSource="{Binding Rooms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemHeight="Auto" ItemWidth="Auto"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource RoomCardStyle}" Margin="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="6" Background="#FFF" Margin="0" Height="160" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Width="200" Height="160"/>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="12,6,6,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Price, StringFormat=' {0:C} / ночь'}" Foreground="{DynamicResource WhiteBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding ShortDescription}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding FullDescription}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" MaxWidth="600" Margin="0,0,5,0"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="Категория: " FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>

                                                <TextBlock Text="   |   " FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,0"/>

                                                <TextBlock Text="Кроватей: " FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding NumberOfBeds}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>

                                                <TextBlock Text="   |   " FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,0"/>

                                                <TextBlock Text="Звёзды: " FontWeight="Bold" FontSize="12"/>
                                                <TextBlock Text="{Binding Stars}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </StackPanel>

                                            <TextBlock Text="Удобства:" FontWeight="Bold" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding Amenities}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Content="Подробнее" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.OpenRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="12" Margin="12">
                <StackPanel>
                    <TextBlock Text="Фильтр по доступности" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Дата заезда" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding CheckInDate, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Дата выезда" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <DatePicker SelectedDate="{Binding CheckOutDate, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                        <Button Content="Применить" Style="{DynamicResource SecondaryButton}" Command="{Binding ApplyFilterCommand}"/>
                        <Button Content="Сбросить" Style="{DynamicResource SecondaryButton}" Command="{Binding ClearFilterCommand}" Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>