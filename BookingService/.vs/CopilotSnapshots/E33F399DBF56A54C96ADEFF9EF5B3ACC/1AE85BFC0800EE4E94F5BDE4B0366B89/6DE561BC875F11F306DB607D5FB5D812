<Window x:Class="BookingService.MVVM.Views.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Детали номера" Height="600" Width="900" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: image at left, basic info at right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Background="#FFF" Padding="4" HorizontalAlignment="Left" Width="280" Height="200">
                <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Width="272" Height="192"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding ShortDescription}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" TextTrimming="CharacterEllipsis"/>

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0">
                    <Run Text="Цена: "/>
                    <Run Text="{Binding Price, StringFormat={}{0:C}}"/>
                    <Run Text=" / ночь"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Забронировать" Style="{DynamicResource PrimaryButton}" Width="140"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom: full description and other details full width -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="Полное описание:" FontWeight="Bold"/>
            <TextBlock Text="{Binding FullDescription}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Категория: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="   |   " Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="Кроватей: " FontWeight="Bold"/>
                <TextBlock Text="{Binding NumberOfBeds}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="   |   " Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="Звёзды: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Stars}" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <TextBlock Text="Удобства:" FontWeight="Bold" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding Amenities}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Доступен: " FontWeight="Bold"/>
                <TextBlock Text="{Binding IsAvailable}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="   |   " Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="Балкон: " FontWeight="Bold"/>
                <TextBlock Text="{Binding HasBalcony}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="   |   " Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="Для курящих: " FontWeight="Bold"/>
                <TextBlock Text="{Binding IsNonSmoking}" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>