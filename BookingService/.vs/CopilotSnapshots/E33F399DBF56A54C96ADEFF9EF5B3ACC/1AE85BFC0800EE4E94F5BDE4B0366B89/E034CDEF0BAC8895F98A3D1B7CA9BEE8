<Window x:Class="BookingService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingService"
        mc:Ignorable="d"
        Title="{DynamicResource MainWindowTitle}"
        Width="1440"
        Height="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Cursor="{StaticResource NormalCursor}"
        Icon="D:\4sem\oop\BookingService\Resources\icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12">
                <Button x:Name="ProfileWindow" Content="Профиль" 
                        Style="{DynamicResource SecondaryButton}"
                        FontSize="14" Margin="0,0,10,0"
                        Command="{x:Static local:MainWindow.ProfileCommand}"/>

                <Button x:Name="AdminPanelButton" Content="Панель админа"
                        Style="{DynamicResource SecondaryButton}"
                        FontSize="14"
                        Command="{x:Static local:MainWindow.AdminPanelCommand}" Margin="0,0,10,0"/>

                <Button x:Name="RefreshButton" Content="Обновить" 
                        Style="{DynamicResource SecondaryButton}"
                        FontSize="14" Margin="0,0,10,0"
                        Command="{x:Static local:MainWindow.RefreshInfo}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                <TextBox FontSize="16" x:Name="SearchBox" Width="36" Height="36" 
                         Style="{DynamicResource {x:Type TextBox}}"
                         TextChanged="SearchBox_TextChanged" MinWidth="260"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="12">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AlphabetSort" Content="A-Z" 
                            Style="{DynamicResource SecondaryButton}"
                            FontSize="14" Margin="0,0,6,0"
                            Command="{x:Static local:MainWindow.AlphabetSortCommand}"/>
                    <Button x:Name="CostAscSort" Content="Цена ↑" 
                            Style="{DynamicResource SecondaryButton}"
                            FontSize="14" Margin="0,0,6,0"
                            Command="{x:Static local:MainWindow.CostAscSortCommand}"/>
                    <Button x:Name="CostDiscSort" Content="Цена ↓" 
                            Style="{DynamicResource SecondaryButton}"
                            FontSize="14"
                            Command="{x:Static local:MainWindow.CostDescSortCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Rooms list -->
        <ScrollViewer Grid.Row="1" Margin="16" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource BackgroundBrush}">
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemHeight="Auto" ItemWidth="Auto"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource RoomCardStyle}" Margin="12" MouseLeftButtonUp="RoomCard_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Image -->
                                <Border Grid.Column="0" CornerRadius="6" Background="#FFF" Margin="0" Height="160" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Width="200" Height="160"/>
                                </Border>

                                <!-- Details -->
                                <Grid Grid.Column="1" Margin="12,6,6,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name and price: use Grid for left/right layout -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <!-- Price badge aligned right -->
                                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Price, StringFormat=' {0:C} / ночь'}" Foreground="{DynamicResource WhiteBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Short description: placed in its own row to avoid overlapping -->
                                    <TextBlock Grid.Row="1" Text="{Binding ShortDescription}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding FullDescription}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" MaxWidth="600" Margin="0,0,5,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Категория: " FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>

                                            <TextBlock Text="   |   " FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,0"/>

                                            <TextBlock Text="Кроватей: " FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding NumberOfBeds}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>

                                            <TextBlock Text="   |   " FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,0"/>

                                            <TextBlock Text="Звёзды: " FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Stars}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>

                                        <TextBlock Text="Удобства:" FontWeight="Bold" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Amenities}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Actions row -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="Забронировать" Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0"/>
                                        <Button Content="Подробнее" Style="{DynamicResource SecondaryButton}" Click="OpenRoom_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>