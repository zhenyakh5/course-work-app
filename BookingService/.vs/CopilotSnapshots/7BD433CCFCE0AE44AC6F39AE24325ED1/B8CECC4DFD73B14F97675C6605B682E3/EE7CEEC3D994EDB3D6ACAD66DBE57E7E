using System;
using System.Windows;
using System.Linq;
using System.Windows.Input;
using System.Windows.Controls;
using BookingService.MVVM.Models;
using System.Collections.ObjectModel;
using System.Text.RegularExpressions;
using BookingService.MVVM.ViewModels;

namespace BookingService
{
    public partial class ProfileWindow : Window
    {
        private readonly AppDbContext _context = new AppDbContext();
        private User _currentUser;
        private ProfileViewModel _vm;

        public static RoutedCommand SaveCommand { get; } = new RoutedCommand();
        public static RoutedCommand LanguageChange { get; } = new RoutedCommand();
        public static RoutedCommand ThemeChange { get; } = new RoutedCommand();

        public ObservableCollection<Booking> UserBookings { get; set; } = new ObservableCollection<Booking>();

        public ProfileWindow()
        {
            InitializeComponent();
            _vm = new ProfileViewModel();
            DataContext = _vm;

            CommandBindings.Add(new CommandBinding(SaveCommand, ExecuteSaveCommand));
            LoadUserData();
            LoadBookings();

            _context.DataChanged += () => Dispatcher.Invoke(LoadBookings);
        }

        private void LoadUserData()
        {
            _currentUser = _context.Users.FirstOrDefault(u => u.Id == SessionManager.CurrentUser.Id);
            if (_currentUser != null)
            {
                var usernameTb = this.FindName("UsernameTextBox") as TextBox;
                if (usernameTb != null)
                    usernameTb.Text = _currentUser.Username;
            }
        }

        private void LoadBookings()
        {
            try
            {
                UserBookings.Clear();
                var bookings = _context.Bookings.Where(b => b.UserId == SessionManager.CurrentUser.Id).ToList();
                foreach (var b in bookings)
                {
                    // load related entities
                    b.User = _context.Users.FirstOrDefault(u => u.Id == b.UserId);
                    b.Room = _context.HotelRooms.FirstOrDefault(r => r.Id == b.RoomId);
                    UserBookings.Add(b);
                }

                // ItemsControl is bound to UserBookings via DataContext = this
            }
            catch (System.Exception ex)
            {
                MessageBox.Show($"Ошибка при загрузке бронирований: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void ExecuteSaveCommand(object sender, ExecutedRoutedEventArgs e)
        {
            try
            {

                var usernameTb = this.FindName("UsernameTextBox") as TextBox;
                if (usernameTb != null && _currentUser != null)
                {
                    _currentUser.Username = usernameTb.Text;
                    _context.SaveChanges();
                }

                MessageBox.Show("Изменения сохранены успешно!", "Успех", MessageBoxButton.OK, MessageBoxImage.Information);
                this.Close();
            }
            catch (System.Exception ex)
            {
                MessageBox.Show($"Ошибка при сохранении данных: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void SaveAccount_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                if (_currentUser == null) return;

                var usernameTb = this.FindName("UsernameTextBox") as TextBox;
                var currentPwdBox = this.FindName("CurrentPasswordBox") as PasswordBox;
                var newPwdBox = this.FindName("NewPasswordBox") as PasswordBox;
                var confirmPwdBox = this.FindName("ConfirmPasswordBox") as PasswordBox;

                var newUsername = usernameTb?.Text?.Trim();
                var currentPwd = currentPwdBox?.Password;
                var newPwd = newPwdBox?.Password;
                var confirmPwd = confirmPwdBox?.Password;

                // change username if needed
                if (!string.IsNullOrWhiteSpace(newUsername) && newUsername != _currentUser.Username)
                {
                    if (_context.Users.Any(u => u.Username == newUsername && u.Id != _currentUser.Id))
                    {
                        MessageBox.Show("Логин уже занят", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    _currentUser.Username = newUsername;
                }

                // change password if any password fields filled
                if (!string.IsNullOrEmpty(currentPwd) || !string.IsNullOrEmpty(newPwd) || !string.IsNullOrEmpty(confirmPwd))
                {
                    // verify current
                    if (string.IsNullOrEmpty(currentPwd) || !BCrypt.Net.BCrypt.Verify(currentPwd, _currentUser.Password))
                    {
                        MessageBox.Show("Текущий пароль неверен", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    // validate new password
                    if (string.IsNullOrWhiteSpace(newPwd) || newPwd != confirmPwd)
                    {
                        MessageBox.Show("Новый пароль пустой или не совпадает с подтверждением", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    if (!Regex.IsMatch(newPwd, @"^(?=.*[A-Z]).{6,}$"))
                    {
                        MessageBox.Show("Пароль должен содержать минимум 6 символов и иметь заглавную букву", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    _currentUser.Password = BCrypt.Net.BCrypt.HashPassword(newPwd);
                }

                _context.SaveChanges();
                _context.NotifyDataChanged();

                MessageBox.Show("Данные аккаунта обновлены.", "Успех", MessageBoxButton.OK, MessageBoxImage.Information);
            }
            catch (System.Exception ex)
            {
                MessageBox.Show($"Ошибка при обновлении аккаунта: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void CancelBooking_Click(object sender, RoutedEventArgs e)
        {
            if (sender is Button btn && btn.Tag != null && int.TryParse(btn.Tag.ToString(), out var bookingId))
            {
                var result = MessageBox.Show("Вы уверены, что хотите отменить бронь?", "Подтвердите", MessageBoxButton.YesNo, MessageBoxImage.Question);
                if (result != MessageBoxResult.Yes) return;

                try
                {
                    var booking = _context.Bookings.FirstOrDefault(b => b.Id == bookingId && b.UserId == SessionManager.CurrentUser.Id);
                    if (booking != null)
                    {
                        booking.Status = "Отменено";
                        _context.SaveChanges();
                        _context.NotifyDataChanged();
                        LoadBookings();
                        MessageBox.Show("Бронь отменена.", "Успех", MessageBoxButton.OK, MessageBoxImage.Information);
                    }
                }
                catch (System.Exception ex)
                {
                    MessageBox.Show($"Ошибка при отмене бронирования: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
                }
            }
        }

        private void ShowRoom_Click(object sender, MouseButtonEventArgs e)
        {
            // sender may be Border; find its Tag (room id) or DataContext
            if (sender is FrameworkElement fe)
            {
                // try Tag first
                int roomId = 0;
                if (fe.Tag != null && int.TryParse(fe.Tag.ToString(), out roomId))
                {
                    OpenRoomWindow(roomId);
                    return;
                }

                // otherwise, try get Room from DataContext
                if (fe.DataContext is Booking booking && booking.Room != null)
                {
                    OpenRoomWindow(booking.Room.Id);
                }
            }
        }

        private void OpenRoomWindow(int roomId)
        {
            try
            {
                var vm = new MVVM.ViewModels.RoomViewModel(roomId);
                var wnd = new MVVM.Views.RoomWindow();
                wnd.DataContext = vm;
                wnd.Show();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка при открытии окна номера: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void PasswordBox_PasswordChanged(object sender, RoutedEventArgs e)
        {
            // collect passwords from named boxes and forward to VM
            var current = (this.FindName("CurrentPasswordBox") as PasswordBox)?.Password;
            var nw = (this.FindName("NewPasswordBox") as PasswordBox)?.Password;
            var confirm = (this.FindName("ConfirmPasswordBox") as PasswordBox)?.Password;
            _vm.SetPasswords(current, nw, confirm);
        }
    }
}