using BookingService.MVVM.Models;
using BookingService.MVVM.Views;
using System;
using System.Collections.ObjectModel;
using System.Linq;
using System.Windows;
using System.Windows.Input;

namespace BookingService.MVVM.ViewModels
{
    public class ProfileViewModel : ViewModelBase
    {
        private readonly AppDbContext _context = new AppDbContext();
        private User _currentUser;

        public ObservableCollection<Booking> UserBookings { get; set; } = new ObservableCollection<Booking>();

        private string _username;
        public string Username { get => _username; set { _username = value; OnPropertyChanged(); } }

        private string _currentPassword;
        private string _newPassword;
        private string _confirmPassword;

        public ICommand SaveAccountCommand { get; }
        public ICommand CancelBookingCommand { get; }
        public ICommand OpenRoomCommand { get; }

        public ProfileViewModel()
        {
            SaveAccountCommand = new RelayCommand(_ => SaveAccount());
            CancelBookingCommand = new RelayCommand(CancelBooking);
            OpenRoomCommand = new RelayCommand(OpenRoom);

            LoadUserData();
            LoadBookings();

            _context.DataChanged += () => System.Windows.Application.Current.Dispatcher.Invoke(LoadBookings);
        }

        private void LoadUserData()
        {
            _currentUser = _context.Users.FirstOrDefault(u => u.Id == SessionManager.CurrentUser.Id);
            if (_currentUser != null)
            {
                Username = _currentUser.Username;
            }
        }

        private void LoadBookings()
        {
            try
            {
                UserBookings.Clear();
                var bookings = _context.Bookings.Where(b => b.UserId == SessionManager.CurrentUser.Id).ToList();
                foreach (var b in bookings)
                {
                    b.User = _context.Users.FirstOrDefault(u => u.Id == b.UserId);
                    b.Room = _context.HotelRooms.FirstOrDefault(r => r.Id == b.RoomId);
                    UserBookings.Add(b);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка при загрузке бронирований: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void SaveAccount()
        {
            try
            {
                if (_currentUser == null) return;

                if (!string.IsNullOrWhiteSpace(Username) && Username != _currentUser.Username)
                {
                    if (_context.Users.Any(u => u.Username == Username && u.Id != _currentUser.Id))
                    {
                        MessageBox.Show("Логин уже занят", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    _currentUser.Username = Username;
                }

                // password fields are handled from code-behind (PasswordBox) to keep secure
                if (!string.IsNullOrEmpty(_currentPassword) || !string.IsNullOrEmpty(_newPassword) || !string.IsNullOrEmpty(_confirmPassword))
                {
                    if (string.IsNullOrEmpty(_currentPassword) || !BCrypt.Net.BCrypt.Verify(_currentPassword, _currentUser.Password))
                    {
                        MessageBox.Show("Текущий пароль неверен", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword != _confirmPassword)
                    {
                        MessageBox.Show("Новый пароль пустой или не совпадает с подтверждением", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    if (!System.Text.RegularExpressions.Regex.IsMatch(_newPassword, @"^(?=.*[A-Z]).{6,}$"))
                    {
                        MessageBox.Show("Пароль должен содержать минимум 6 символов и иметь заглавную букву", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Warning);
                        return;
                    }

                    _currentUser.Password = BCrypt.Net.BCrypt.HashPassword(_newPassword);
                }

                _context.SaveChanges();
                _context.NotifyDataChanged();
                MessageBox.Show("Данные аккаунта обновлены.", "Успех", MessageBoxButton.OK, MessageBoxImage.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка при обновлении аккаунта: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        public void SetPasswords(string current, string nw, string confirm)
        {
            _currentPassword = current;
            _newPassword = nw;
            _confirmPassword = confirm;
        }

        private void CancelBooking(object parameter)
        {
            if (parameter == null) return;
            if (!int.TryParse(parameter.ToString(), out var bookingId)) return;

            var result = MessageBox.Show("Вы уверены, что хотите отменить бронь?", "Подтвердите", MessageBoxButton.YesNo, MessageBoxImage.Question);
            if (result != MessageBoxResult.Yes) return;

            try
            {
                var booking = _context.Bookings.FirstOrDefault(b => b.Id == bookingId && b.UserId == SessionManager.CurrentUser.Id);
                if (booking != null)
                {
                    booking.Status = "Отменено";
                    _context.SaveChanges();
                    _context.NotifyDataChanged();
                    LoadBookings();
                    MessageBox.Show("Бронь отменена.", "Успех", MessageBoxButton.OK, MessageBoxImage.Information);
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка при отмене бронирования: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        private void OpenRoom(object parameter)
        {
            if (parameter == null) return;
            if (!int.TryParse(parameter.ToString(), out var roomId)) return;

            var vm = new RoomViewModel(roomId);
            var wnd = new RoomWindow();
            wnd.DataContext = vm;
            wnd.Show();
        }
    }
}
