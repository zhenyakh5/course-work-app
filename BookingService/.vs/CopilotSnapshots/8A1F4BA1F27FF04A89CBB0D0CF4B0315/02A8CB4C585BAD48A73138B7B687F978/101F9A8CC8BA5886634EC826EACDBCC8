using System.Windows;
using BookingService.MVVM.ViewModels;
using BookingService.Services;

namespace BookingService
{
    public partial class MainWindow : Window
    {
        private readonly AppDbContext _context = new AppDbContext();

        public MainWindow()
        {
            InitializeComponent();

            var roomService = new RoomService(_context);
            var navigationService = new NavigationService();
            navigationService.SetCurrentWindow(this);

            DataContext = new MainWindowViewModel(roomService, navigationService, _context);

            // Show admin panel button visibility handled in XAML via SessionManager or code-behind if needed
            ShowAdminPanel();
        }

        public void ShowAdminPanel()
        {
            AdminPanelButton.Visibility = (SessionManager.CurrentUser?.IsAdmin == true)
                ? Visibility.Visible
                : Visibility.Collapsed;
        }

        protected override void OnClosed(System.EventArgs e)
        {
            _context.Dispose();
            base.OnClosed(e);
        }
    }
}