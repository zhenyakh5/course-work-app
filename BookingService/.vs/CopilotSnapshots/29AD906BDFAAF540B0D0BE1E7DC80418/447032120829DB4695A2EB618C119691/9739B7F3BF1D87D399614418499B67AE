<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="BookingService.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingService"
        mc:Ignorable="d"
        Title="Личный кабинет" 
        Height="600" 
        Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: account settings -->
        <StackPanel Grid.Column="0">
            <Label Content="{DynamicResource ProfileHeader}" Style="{DynamicResource HeaderLabel}" HorizontalContentAlignment="Center"/>

            <TextBlock Text="{DynamicResource UsernameLabel}" Style="{DynamicResource FormLabelText}"/>
            <TextBox x:Name="UsernameTextBox" Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12" Width="280"/>

            <TextBlock Text="Текущий пароль" Style="{DynamicResource FormLabelText}"/>
            <PasswordBox x:Name="CurrentPasswordBox" Margin="0,2,0,12" Width="280"/>

            <TextBlock Text="Новый пароль" Style="{DynamicResource FormLabelText}"/>
            <PasswordBox x:Name="NewPasswordBox" Margin="0,2,0,12" Width="280"/>

            <TextBlock Text="Подтвердите новый пароль" Style="{DynamicResource FormLabelText}"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,2,0,12" Width="280"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="{DynamicResource SaveButton}" Style="{DynamicResource PrimaryButton}" FontSize="14" Width="120" Click="SaveAccount_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Right: bookings -->
        <GroupBox Header="Мои бронирования" Grid.Column="1" Margin="12,0,0,0">
            <ScrollViewer>
                <ItemsControl x:Name="BookingsItems" ItemsSource="{Binding UserBookings}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource RoomCardStyle}" Margin="8" Width="320">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="6" Background="#FFF" Height="110" Width="132" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding Room.ImagePath}" Stretch="UniformToFill" Width="132" Height="110"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="8">
                                        <TextBlock Text="{Binding Room.Name}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Room.ShortDescription}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TotalPrice, StringFormat={}{0:C}}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                            <Run Text="Статус: "/>
                                            <Run Text="{Binding Status}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource MutedTextBrush}">
                                            <Run Text="Даты: "/>
                                            <Run Text="{Binding CheckInDate, StringFormat={}{0:d}}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding CheckOutDate, StringFormat={}{0:d}}"/>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="Отменить" Tag="{Binding Id}" Click="CancelBooking_Click" Style="{DynamicResource DeleteButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>