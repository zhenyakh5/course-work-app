<Window x:Class="BookingService.MVVM.Views.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource RoomWindowTitle}" Height="600" Width="900" Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: image at left, basic info at right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" Background="#FFF" Padding="4" HorizontalAlignment="Left" Width="280" Height="200">
                <Image Source="{Binding Room.ImagePath}" Stretch="UniformToFill" Width="272" Height="192"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Room.Name}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding Room.ShortDescription}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="520" TextTrimming="CharacterEllipsis"/>

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0">
                    <Run Text="{DynamicResource PriceLabelShort}" />
                    <Run Text="{Binding Room.Price, StringFormat={}{0:C}}"/>
                    <Run Text="/"/>
                    <Run Text="{DynamicResource NightLabel}"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{DynamicResource BookButton}" Style="{DynamicResource PrimaryButton}" Width="140"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom: full description and other details full width -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource FullDescriptionLabelShort}" FontWeight="Bold"/>
            <TextBlock Text="{Binding Room.FullDescription}" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource CategoryLabelShort}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Room.Category}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource SeparatorLabel}" Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource BedsLabelShort}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Room.NumberOfBeds}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource SeparatorLabel}" Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource StarsLabelShort}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Room.Stars}" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <TextBlock Text="{DynamicResource AmenitiesLabelShort}" FontWeight="Bold" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding Room.Amenities}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource AvailableLabel}" FontWeight="Bold"/>
                <TextBlock Text="{Binding RoomIsAvailableText}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource SeparatorLabel}" Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource BalconyLabelShort}" FontWeight="Bold"/>
                <TextBlock Text="{Binding RoomHasBalconyText}" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource SeparatorLabel}" Margin="8,0" Foreground="{DynamicResource MutedTextBrush}"/>

                <TextBlock Text="{DynamicResource NonSmokingLabelShort}" FontWeight="Bold"/>
                <TextBlock Text="{Binding RoomIsNonSmokingText}" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>