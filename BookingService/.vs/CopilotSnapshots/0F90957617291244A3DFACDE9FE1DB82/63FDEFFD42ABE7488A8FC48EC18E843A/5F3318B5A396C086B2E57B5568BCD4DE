using System;
using System.Collections.Generic;
using System.Data.Entity;
using System.Data.SqlClient;
using System.Windows;

namespace BookingService
{
    public class AppDbContext : DbContext
    {
        private readonly Stack<ICommand> _undoStack = new Stack<ICommand>();
        private readonly Stack<ICommand> _redoStack = new Stack<ICommand>();

        public event Action DataChanged;

        public DbSet<User> Users { get; set; }
        public DbSet<HotelRoom> HotelRooms { get; set; }

        // Primary connection string used by the original project
        private const string PrimaryConnectionString = "Server=zhenyakh; Database=HotelDatabase; TrustServerCertificate=True; Integrated Security=True;";
        // Fallback to LocalDB when the primary server is unavailable
        private const string LocalDbFallbackConnectionString = "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=HotelDatabase_Local;Integrated Security=True;";

        static AppDbContext()
        {
            // Ensure EF will create the database from the model if it does not exist.
            Database.SetInitializer(new CreateDatabaseIfNotExists<AppDbContext>());
        }

        public AppDbContext() : base(GetEffectiveConnectionString())
        {
            Configuration.LazyLoadingEnabled = false;
            Configuration.ProxyCreationEnabled = false;

            try
            {
                // Force initialization so the DB is created when the context is constructed
                Database.Initialize(true);
            }
            catch (Exception ex)
            {
                // Inform the user but allow the app to continue using fallback where possible
                MessageBox.Show($"Ошибка инициализации базы данных: {ex.Message}", "Информация", MessageBoxButton.OK, MessageBoxImage.Warning);
            }
        }

        private static string GetEffectiveConnectionString()
        {
            // First, try the primary server connection by attempting to open a SQL connection.
            try
            {
                using (var conn = new SqlConnection(PrimaryConnectionString))
                {
                    conn.Open();
                    // If open succeeded, use primary string
                    return PrimaryConnectionString;
                }
            }
            catch
            {
                // Primary server is unavailable: fall back to LocalDB
                try
                {
                    using (var conn = new SqlConnection(LocalDbFallbackConnectionString))
                    {
                        conn.Open();
                        return LocalDbFallbackConnectionString;
                    }
                }
                catch
                {
                    // If even LocalDB is unavailable, still return the LocalDB string so EF can try to create it.
                    return LocalDbFallbackConnectionString;
                }
            }
        }

        public void ExecuteCommand(ICommand command)
        {
            try
            {
                command.Execute();
                _undoStack.Push(command);
                _redoStack.Clear();
                NotifyDataChanged();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        public void NotifyDataChanged()
        {
            DataChanged?.Invoke();
        }

        public bool CanUndo => _undoStack.Count > 0;
        public bool CanRedo => _redoStack.Count > 0;

        public void Undo()
        {
            if (!CanUndo) return;

            try
            {
                var command = _undoStack.Pop();
                command.Undo();
                _redoStack.Push(command);
                DataChanged?.Invoke();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка отмены: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }

        public void Redo()
        {
            if (!CanRedo) return;

            try
            {
                var command = _redoStack.Pop();
                command.Execute();
                _undoStack.Push(command);
                DataChanged?.Invoke();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка повтора: {ex.Message}", "Ошибка", MessageBoxButton.OK, MessageBoxImage.Error);
            }
        }
    }
}