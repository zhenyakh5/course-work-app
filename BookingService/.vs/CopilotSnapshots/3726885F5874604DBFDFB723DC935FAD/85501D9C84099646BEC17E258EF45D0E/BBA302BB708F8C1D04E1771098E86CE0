<Window x:Class="BookingService.MVVM.Views.DeleteRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Удалить номер" 
        Height="450" 
        Width="800"
        Background="{DynamicResource BackgroundBrush}"
        Cursor="{StaticResource NormalCursor}"
        WindowStartupLocation="CenterScreen"
        Icon="D:\4sem\oop\BookingService\Resources\icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Section -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     Width="360" 
                     Style="{DynamicResource {x:Type TextBox}}" Margin="0,0,10,0"/>
            <!-- Search Popup -->
            <Popup x:Name="SearchPopup" 
       PlacementTarget="{Binding ElementName=SearchTextBox}" 
       StaysOpen="False" 
       IsOpen="{Binding IsSearchPopupOpen}"
       Width="{Binding ActualWidth, ElementName=SearchTextBox}">
                <ListBox ItemsSource="{Binding SearchResults}" 
             SelectedItem="{Binding SelectedRoom}"
             MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ShortDescription}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Popup>
        </StackPanel>

        <!-- Selected Room Info -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="12" 
                Visibility="{Binding IsRoomSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Выбранный номер:" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="{Binding SelectedRoom.Name}" FontSize="14" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SelectedRoom.ShortDescription}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SelectedRoom.Category}" FontSize="12" Foreground="Gray" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SelectedRoom.Price, StringFormat='Цена: {0:C}'}" FontSize="12" Foreground="Green" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Удалить" 
                    Style="{DynamicResource DeleteButton}" 
                    Command="{Binding DeleteCommand}" 
                    FontSize="16"
                    Visibility="{Binding IsRoomSelected, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,12,0"/>
            <Button Content="Отмена" 
                    Style="{DynamicResource SecondaryButton}" 
                    Command="{Binding CancelCommand}" 
                    FontSize="16"/>
        </StackPanel>
    </Grid>
</Window></Window>