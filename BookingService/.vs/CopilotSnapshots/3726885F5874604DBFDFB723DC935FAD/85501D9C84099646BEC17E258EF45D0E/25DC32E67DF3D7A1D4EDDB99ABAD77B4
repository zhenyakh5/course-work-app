<Window x:Class="BookingService.MVVM.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingService.MVVM.Views"
        mc:Ignorable="d"
        Title="Регистрация" 
        Height="520" 
        Width="420" 
        Background="{DynamicResource BackgroundBrush}"
        Cursor="{StaticResource NormalCursor}"
        WindowStartupLocation="CenterScreen"
        Icon="D:\4sem\oop\BookingService\Resources\icon.ico">

    <Grid>
        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Orientation="Vertical" 
                    Margin="20">

            <Label Content="Создать аккаунт" 
                   Style="{DynamicResource HeaderLabel}"/>

            <Label Content="Имя пользователя" Style="{DynamicResource FormLabel}"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

            <Label Content="Email" Style="{DynamicResource FormLabel}"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{DynamicResource {x:Type TextBox}}" Margin="0,2,0,12"/>

            <Label Content="Пароль" Style="{DynamicResource FormLabel}"/>
            <PasswordBox x:Name="PasswordBox" 
                         Style="{DynamicResource {x:Type PasswordBox}}" Margin="0,2,0,12"/>

            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center" 
                        Margin="0,20,0,0">

                <Button Content="Зарегистрироваться" 
                        Style="{DynamicResource PrimaryButton}" 
                        Command="{Binding RegisterCommand}" Margin="0,0,12,0"/>

                <Button Content="Отмена" 
                        Style="{DynamicResource SecondaryButton}" 
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>